# LabelLens backend environment template (placeholders only).
# Copy to backend/.env and fill in real values. Never commit .env.
# Frontend must NEVER receive any of these (no NEXT_PUBLIC_* here).

# Application
ENVIRONMENT=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# Primary database (Postgres via Supabase in production).
# Async SQLAlchemy URL; service-role credentials live here, server-only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens

# Isolated database used ONLY by live integration tests.
# Never point this at production or shared data.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens_test

# Supabase project reference (server-side use only).
SUPABASE_URL=https://<project>.supabase.co
# Service-role key bypasses RLS by design: backend-only, never logged.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Stage 12: authentication -----------------------------------------
# Supabase access tokens are verified against the project JWKS
# (derived from SUPABASE_URL). Signing keys are NOT configured here.
# In production these must be set and DEV_API_TOKENS must be absent,
# or the application refuses to start.
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# SUPABASE_JWT_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Asymmetric only; a symmetric (HS256) project fails closed.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWT_LEEWAY_SECONDS=60
SUPABASE_JWT_JWKS_TTL_SECONDS=300
SUPABASE_JWT_JWKS_MIN_REFRESH_SECONDS=30
SUPABASE_JWT_JWKS_MAX_KEYS=16
SUPABASE_JWT_FETCH_TIMEOUT_SECONDS=5
# Comma-separated reviewer subjects. Empty means nobody can review.
SUPABASE_REVIEWER_SUBJECTS=
# Development/tests only. Forbidden when ENVIRONMENT=production.
# DEV_API_TOKENS=dev-reader-token:user-dev-1:reader,dev-reviewer-token:user-dev-2:reviewer

# --- Stage 12: rate limiting (per process; see SECURITY.md §7) --------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OBSERVATION_CREATE=30/60
RATE_LIMIT_ANALYZE=20/60
RATE_LIMIT_REVIEW_DECISION=20/60
RATE_LIMIT_INCLUDE_IP=false
RATE_LIMIT_MAX_KEYS=10000
