# LabelLens backend environment template (placeholders only).
# Copy to backend/.env and fill in real values. Never commit .env.
# Frontend must NEVER receive any of these (no NEXT_PUBLIC_* here).

# Application
ENVIRONMENT=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# Primary database (Postgres via Supabase in production).
# Async SQLAlchemy URL; service-role credentials live here, server-only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens

# Isolated database used ONLY by live integration tests.
# Never point this at production or shared data.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labellens_test

# Supabase project reference (server-side use only).
SUPABASE_URL=https://<project>.supabase.co
# Service-role key bypasses RLS by design: backend-only, never logged.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
