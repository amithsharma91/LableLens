# Public browser configuration — placeholders only, never real values.
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and must never
# be committed.
#
# SECURITY: only these two variables may ever reach the browser. Vite inlines
# only `VITE_`-prefixed variables into the client bundle, and
# `npm run build` fails if a privileged key or token material reaches `dist/`.
# Never put the project's service-role key in this directory, and never give it
# a VITE_ prefix: that key bypasses row-level security entirely.

# Project URL. Must be https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable anon key ONLY (Dashboard > Project Settings > API).
# It is designed to be visible in browsers. This is NOT the secret key.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key